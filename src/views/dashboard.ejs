<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>Dashboard</h2>
        <p>Name: <%= name %>
        </p>
        <p>Username: <%= email %>
        </p>

        <h2>Your Volunteer Projects</h2>
        
        <% if (projects.length> 0) { %>
            <ul>
                <% projects.forEach(project=> { %>
                    <li>
                        <%= project.title %>
                            <a href="/project/<%= project.project_id %>/remove-volunteer">
                                Remove yourself
                            </a>
                    </li>
                    <% }); %>
            </ul>
        <% } else { %>
            <p>You are not volunteering for any projects.</p>
        <% } %>

     
        <% if (user && user.role_name==='admin' ) { %>
            <p>
            <a href="/users">View Users</a>
            </p>
        <% } %>
        
    </main>

    <%- include('partials/footer') %>