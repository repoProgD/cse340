<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <ul>
            <% categories.forEach(category=> { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                </li>
                <% }) %>
        </ul>

        <p>
            <% if (user && user.role_name==='admin' ) { %>
                <a href="/new-category">Add a new category</a>
            <% } %>
        </p>
    </main>

<%- include('partials/footer') %>