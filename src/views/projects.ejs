<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>Upcoming Service Projects</h2>

        <ul>
            <% projects.forEach(project=> { %>
                <li>
                    <%= project.date.toLocaleDateString('en-US', { year: 'numeric' , month: 'long' , day: 'numeric' }) %>:
                
                        <% if (user && user.role_name==='admin' ) { %>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
                        <% } else { %>
                            <%= project.title %>
                        <% } %>
    
                        (
                        <% if (user && user.role_name==='admin' ) { %>
                            <a href="/organization/<%= project.organization_id %>">
                                <%= project.organization_name %>
                            </a>
                        <% } else { %>
                            <%= project.organization_name %>
                        <% } %>
                        )
                </li>
                <% }) %>
        </ul>
        <p>
            <% if (user && user.role_name==='admin' ) { %>
                <a href="/new-project">Add a New Service Project</a>
            <% } %>
        </p>
    </main>

    <%- include('partials/footer') %>